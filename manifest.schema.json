{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "喜悦声明式能力 v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "description", "fields", "steps"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 32},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "fields": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["key", "label", "kind", "required"], "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"}, "label": {"type": "string", "minLength": 1, "maxLength": 120}, "kind": {"enum": ["text", "number", "credential_ref"]}, "required": {"type": "boolean"}, "default": {"type": "string", "maxLength": 2000}}, "allOf": [{"if": {"properties": {"kind": {"const": "credential_ref"}}}, "then": {"properties": {"default": {"maxLength": 0}}}}]}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"enum": ["say", "confirm", "timer"]}, "text": {"type": "string", "minLength": 1, "maxLength": 4000}, "seconds": {"type": "integer", "minimum": 0, "maximum": 604800}}, "allOf": [{"if": {"properties": {"kind": {"const": "timer"}}}, "then": {"required": ["seconds"], "properties": {"seconds": {"minimum": 1}}}, "else": {"properties": {"seconds": {"const": 0}}}}]}}
  }
}
