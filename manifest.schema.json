{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "喜悦声明式能力包（当前结构）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "description",
    "fields",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "作者声明的内容版本，建议使用语义化版本；当前 Agent 不比较、自动升级或解析版本。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "kind",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "text",
              "number",
              "credential_ref",
              "secret"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "credential_ref",
                    "secret"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "maxLength": 0
                }
              }
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "say",
              "confirm",
              "timer"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 604800
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "timer"
                }
              }
            },
            "then": {
              "required": [
                "seconds"
              ],
              "properties": {
                "seconds": {
                  "minimum": 1
                }
              }
            },
            "else": {
              "properties": {
                "seconds": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "description": "仅支持 say、confirm、timer；version 是能力内容版本，不是协议版本。启用状态、配置、权限和任务状态不属于包。Agent 额外按 UTF-8 字节限制字符串长度。"
}
